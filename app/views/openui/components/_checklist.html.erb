<%# locals: (openui:, element:, items: [], title: nil) %>
<div class="openui-checklist">
  <% if title.present? %><h3 class="mb-2 text-sm font-semibold text-gray-900 dark:text-gray-100"><%= openui.text(title) %></h3><% end %>
  <ul class="space-y-2 text-sm">
    <% Array(items).each do |item| %>
      <% next unless item.is_a?(Hash) %>
      <% if item["done"] == true %>
        <li class="flex items-start gap-2 text-gray-500 dark:text-gray-400">
          <%= openui_icon("circle-check", size: 18, class: "mt-px shrink-0 text-green-600 dark:text-green-400") %>
          <span class="line-through"><%= openui.text(item["label"]) %></span>
          <span class="sr-only">(done)</span>
        </li>
      <% else %>
        <li class="flex items-start gap-2 text-gray-900 dark:text-gray-100">
          <%= openui_icon("circle", size: 18, class: "mt-px shrink-0 text-gray-300 dark:text-gray-600") %>
          <span><%= openui.text(item["label"]) %></span>
        </li>
      <% end %>
    <% end %>
  </ul>
</div>
