<%# locals: (openui:, element:, name:, children: [], title: nil) %>
<%# Inert: a div, not a <form>, so nothing submits until the host wires the Button actions. %>
<div class="openui-form flex flex-col gap-4 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900"
  role="form" aria-label="<%= openui.text(title.presence || name) %>" data-openui-form="<%= openui.text(name) %>">
  <% if title.present? %><h3 class="text-base font-semibold text-gray-900 dark:text-gray-100"><%= openui.text(title) %></h3><% end %>
  <%= openui.node(children) %>
</div>
