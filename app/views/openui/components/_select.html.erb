<%# locals: (openui:, element:, name:, options: [], label: nil, value: nil) %>
<% field_id = "openui-#{element.statement_id || name}-#{name}".parameterize %>
<div class="openui-select flex flex-col gap-1.5">
  <% if label.present? %><label for="<%= field_id %>" class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= openui.text(label) %></label><% end %>
  <select id="<%= field_id %>" name="<%= openui.text(name) %>"
    class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100">
    <% Array(options).each do |option| %>
      <% option = openui.text(option) %>
      <option value="<%= option %>"<% if option == openui.text(value) %> selected<% end %>><%= option %></option>
    <% end %>
  </select>
</div>
