<%# locals: (openui:, element:, name:, subtitle: nil, src: nil) %>
<% src = openui_safe_src(openui.text(src)) %>
<div class="openui-avatar flex items-center gap-3">
  <% if src %>
    <img src="<%= src %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="size-10 shrink-0 rounded-full object-cover">
  <% else %>
    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-semibold text-blue-700 dark:bg-blue-500/20 dark:text-blue-300" aria-hidden="true"><%= openui_initials(openui.text(name)) %></span>
  <% end %>
  <div class="min-w-0">
    <p class="truncate text-sm font-medium text-gray-900 dark:text-gray-100"><%= openui.text(name) %></p>
    <% if subtitle.present? %><p class="truncate text-sm text-gray-500 dark:text-gray-400"><%= openui.text(subtitle) %></p><% end %>
  </div>
</div>
