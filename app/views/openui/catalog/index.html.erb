<% catalog = OpenUI::Rails::Catalog %>
<% library = catalog.library %>
<header class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
  <div class="mx-auto flex max-w-6xl items-start justify-between gap-4 px-4 py-6 sm:px-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Component catalog</h1>
      <p class="mt-1 max-w-2xl text-sm text-gray-600 dark:text-gray-400">
        What an agent can build with openui-rails. Every example below is an OpenUI Lang program,
        parsed and rendered by the gem's own parser and partials.
        <%= library.component_names.length %> components, <%= catalog.entries.length %> examples.
      </p>
      <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-600 dark:text-gray-400">
        <span class="inline-flex items-center gap-1.5"><span class="rounded-md bg-gray-50 px-2 py-0.5 font-mono text-gray-700 ring-1 ring-inset ring-gray-500/20 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-700">Name</span> starter library, styled by openui.css</span>
        <span class="inline-flex items-center gap-1.5"><span class="rounded-md bg-blue-50 px-2 py-0.5 font-mono text-blue-700 ring-1 ring-inset ring-blue-700/10 dark:bg-blue-400/10 dark:text-blue-300 dark:ring-blue-400/30">Name</span> added in the catalog library, styled with Tailwind</span>
      </p>
    </div>
    <button type="button" data-theme-toggle
      class="inline-flex shrink-0 items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-100 dark:ring-gray-700 dark:hover:bg-gray-700">
      <span class="dark:hidden inline-flex items-center gap-2"><%= openui_icon("moon") %>Dark</span>
      <span class="hidden dark:inline-flex items-center gap-2"><%= openui_icon("sun") %>Light</span>
    </button>
  </div>
  <nav class="mx-auto max-w-6xl overflow-x-auto px-4 pb-3 sm:px-6" aria-label="Categories">
    <ul class="flex gap-2 whitespace-nowrap text-sm">
      <% catalog.categories.each do |name, entries| %>
        <li><a href="#<%= name.parameterize %>" class="inline-block rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"><%= name %> <span class="text-gray-400 dark:text-gray-500"><%= entries.length %></span></a></li>
      <% end %>
    </ul>
  </nav>
</header>

<main class="mx-auto max-w-6xl space-y-12 px-4 py-8 sm:px-6">
  <% catalog.categories.each do |name, entries| %>
    <section id="<%= name.parameterize %>" class="scroll-mt-4 space-y-6" data-catalog-category="<%= name %>">
      <h2 class="text-xl font-semibold tracking-tight"><%= name %></h2>
      <% entries.each do |entry| %>
        <% html, problems = catalog.render(entry, view_context: self) %>
        <article id="entry-<%= entry.id %>" class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900"
          data-catalog-entry="<%= entry.id %>" data-catalog-problems="<%= problems.length %>">
          <header class="flex flex-col gap-2 border-b border-gray-200 px-4 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-gray-800">
            <div>
              <h3 class="font-semibold"><%= entry.title %></h3>
              <p class="text-sm text-gray-600 dark:text-gray-400"><span class="font-medium text-gray-700 dark:text-gray-300">When the agent uses it:</span> <%= entry.use %></p>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              <% entry.components.each do |component| %>
                <% added = catalog.status(component) == "added-in-catalog" %>
                <li class="rounded-md px-2 py-0.5 font-mono text-xs ring-1 ring-inset <%= added ? "bg-blue-50 text-blue-700 ring-blue-700/10 dark:bg-blue-400/10 dark:text-blue-300 dark:ring-blue-400/30" : "bg-gray-50 text-gray-700 ring-gray-500/20 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-700" %>"
                  title="<%= catalog.status(component) %>"><%= component %></li>
              <% end %>
            </ul>
          </header>
          <% if problems.any? %>
            <div class="catalog-problems border-b border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300" role="alert">
              <% problems.each do |problem| %><p><%= problem %></p><% end %>
            </div>
          <% end %>
          <div class="grid lg:grid-cols-2">
            <div class="min-w-0 bg-gray-50 p-4 sm:p-6 dark:bg-gray-950">
              <%= content_tag(:div, html, id: "catalog-#{entry.id}", class: "openui-root") %>
            </div>
            <div class="min-w-0 border-t border-gray-200 lg:border-l lg:border-t-0 dark:border-gray-800">
              <div class="flex items-center justify-between px-4 pt-3">
                <span class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">OpenUI Lang</span>
                <button type="button" data-copy="snippet-<%= entry.id %>"
                  class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800">
                  <%= openui_icon("copy", size: 14) %><span data-copy-label>Copy</span>
                </button>
              </div>
              <pre class="whitespace-pre-wrap break-words px-4 pb-4 pt-2 font-mono text-xs leading-5 text-gray-800 dark:text-gray-200"><code id="snippet-<%= entry.id %>"><%= entry.snippet %></code></pre>
            </div>
          </div>
          <details class="group border-t border-gray-200 dark:border-gray-800">
            <summary class="flex cursor-pointer list-none items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-800/50">
              <%= openui_icon("chevron-down", size: 14, class: "transition-transform -rotate-90 group-open:rotate-0") %>Styled from
            </summary>
            <div class="grid gap-4 px-4 pb-4 sm:grid-cols-2">
              <% entry.components.each do |component| %>
                <% style = catalog.styled_from(component) %>
                <div class="text-xs" data-styled-from="<%= component %>">
                  <p class="font-semibold text-gray-900 dark:text-gray-100"><%= component %>
                    <span class="font-normal text-gray-500 dark:text-gray-400">(<%= catalog.status(component) %>)</span></p>
                  <p class="mt-0.5 break-all font-mono text-gray-600 dark:text-gray-400"><%= catalog.partial_path(component) %><% if catalog.status(component) == "starter" %> + <%= OpenUI::Rails::Catalog::STARTER_CSS %><% end %></p>
                  <dl class="mt-2 grid grid-cols-[6.5rem_1fr] gap-x-2 gap-y-1">
                    <% {"Background" => :background, "Border" => :border, "Radius" => :radius, "Typography" => :type, "Accent" => :accent}.each do |label, key| %>
                      <dt class="text-gray-500 dark:text-gray-400"><%= label %></dt>
                      <dd class="break-words font-mono text-gray-800 dark:text-gray-200"><%= style[key] %></dd>
                    <% end %>
                  </dl>
                  <% if style[:notes] %><p class="mt-2 text-gray-600 dark:text-gray-400"><%= style[:notes] %></p><% end %>
                </div>
              <% end %>
            </div>
          </details>
        </article>
      <% end %>
    </section>
  <% end %>
</main>
<footer class="mx-auto max-w-6xl px-4 pb-10 text-xs text-gray-500 sm:px-6 dark:text-gray-400">
  Library <code class="font-mono"><%= library.id %></code> <%= library.version %>. Buttons and form controls are inert: their action plans are in <code class="font-mono">data-openui-action</code>.
  Component index: CATALOG.md in the gem.
</footer>
