<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>openui-rails demo</title>
    <%= csrf_meta_tags %>
    <%= openui_stylesheet_tag %>
    <%= javascript_include_tag "turbo.min", type: "module" %>
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; font: 15px/1.5 system-ui, -apple-system, sans-serif; background: Canvas; color: CanvasText; }
      main { max-width: 820px; margin: 0 auto; padding: 32px 20px 64px; }
      h1 { font-size: 1.4em; margin: 0 0 4px; }
      .lede { margin: 0 0 24px; opacity: 0.7; }
      form textarea { width: 100%; box-sizing: border-box; min-height: 90px; font: inherit; padding: 10px; border-radius: 8px; border: 1px solid color-mix(in srgb, CanvasText 25%, transparent); background: transparent; color: inherit; }
      form button { margin-top: 10px; padding: 8px 14px; border-radius: 8px; border: 1px solid color-mix(in srgb, CanvasText 25%, transparent); background: transparent; color: inherit; font: inherit; cursor: pointer; }
      .answer { margin-top: 24px; }
      details { margin-top: 24px; opacity: 0.85; }
      pre { white-space: pre-wrap; font-size: 12.5px; padding: 12px; border-radius: 8px; background: color-mix(in srgb, CanvasText 6%, transparent); }
      .status { margin-top: 12px; font-size: 0.85em; opacity: 0.7; }
      nav a { margin-right: 14px; }
    </style>
  </head>
  <body>
    <main>
      <nav><%= link_to "Demo", demo_path %><%= link_to "Static sample", sample_path %><%= link_to "Catalog", catalog_path %></nav>
      <%= yield %>
    </main>
  </body>
</html>
