# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 7.1.0"
gem "json", "< 3"
gem "turbo-rails", ">= 2.0"
gem "propshaft"
gem "puma"
gem "ruby_llm", ">= 1.16", "< 3"
gem "minitest", ">= 5.20"
gem "rake"
gem "webmock"
gem "rails-dom-testing"
gem "concurrent-ruby", "< 1.3.5" # Rails 7.1 needs Logger loaded before concurrent-ruby 1.3.5
